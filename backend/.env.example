# Database Configuration
DATABASE_URL=sqlite:///./dontbuyyet.db
DATABASE_ECHO=false

# Application Configuration
APP_NAME=Don't Buy Yet
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# API Configuration
API_V1_STR=/api/v1

# LLM Configuration (optional)
LLM_API_KEY=
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2
LLM_ENABLED=false

# Model API Configuration (for OpenAI compatibility)
MODEL_API_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=your_api_key_here
MODEL_NAME=gpt-3.5-turbo
MODEL_TIMEOUT_SECONDS=30
MODEL_MAX_RETRIES=3

# Security Configuration
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_ENABLED=false
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# Cache Configuration
CACHE_ENABLED=false
CACHE_TTL=300

# Application Specific
DEFAULT_COOLING_HOURS=24
MAX_COOLING_HOURS=168
MIN_PURCHASE_AMOUNT=0.01
MAX_PURCHASE_AMOUNT=1000000.00

# Scoring Configuration
SCORING_WEIGHTS={"price": 0.3, "need": 0.4, "urgency": 0.3}

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=false

# Email Configuration (optional)
SMTP_SERVER=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=